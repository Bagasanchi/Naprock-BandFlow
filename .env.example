EXPO_PUBLIC_API_URL=http://bandflow.local:8787

# Node API / BLE bridge
PORT=8787
DATABASE_PATH=/var/lib/bandflow/bandflow.sqlite
BLE_BRIDGE_URL=http://127.0.0.1:5000/v1/dispatch
BLE_INTERNAL_TOKEN=replace-with-a-shared-secret

# Flask callback and durable transport state
NODE_EVENT_URL=http://127.0.0.1:8787/internal/ble/events
BLE_EVENT_QUEUE_PATH=/var/lib/bandflow/ble-event-queue.json
BLE_ASSIGNMENT_STATE_PATH=/var/lib/bandflow/ble-assignment.json

# AI task planning (free key from https://aistudio.google.com): splits a task title into steps
# for the wristband and picks its Eisenhower category. Leave empty to turn it off.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash   (optional: the model to try first)

# Optional provider-neutral AI services (used instead of Gemini when set)
AI_BREAKDOWN_URL=
AI_BREAKDOWN_TOKEN=
AI_CLASSIFICATION_URL=
AI_CLASSIFICATION_TOKEN=
